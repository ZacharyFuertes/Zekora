# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth 2.0 (Cloud Console Credentials -> OAuth 2.0 Client IDs -> Web application)
# Authorized redirect URI: {YOUR_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# AES-256-CBC encryption key for Google refresh tokens at rest.
# Use a 32-byte secret (64-char hex). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

